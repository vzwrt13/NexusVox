; Inno Setup script for the NexusVox per-user installer.
;
; Build with:  python packaging/build_installer.py   (after `python packaging/build.py`)
; or directly: ISCC /DAppVersion=0.7.0 /DAppVersionInfo=0.7.0.0 packaging\nexusvox.iss
; (dist\installer\THIRD_PARTY_NOTICES.txt must exist first; build_installer.py writes it.)
;
; Per-user, no admin rights: the app goes to %LOCALAPPDATA%\Programs\NexusVox. The file name of the
; installer is stable on purpose (NexusVox-Setup.exe, no version): the website links to
; releases/latest/download/NexusVox-Setup.exe and download reputation is tracked per file name.
; The installer is unsigned for now.

; build_installer.py passes both: AppVersion is shown as it is ("1.0.0rc1" is fine), AppVersionInfo is the numeric
; "1.0.0.0" form that VersionInfoVersion insists on.
#ifndef AppVersion
  #define AppVersion "0.0.0"
#endif
#ifndef AppVersionInfo
  #define AppVersionInfo "0.0.0.0"
#endif

#define AppName "NexusVox"
#define AppExe "NexusVox.exe"

[Setup]
; Never change this GUID: it identifies the installed app for upgrades and for Add/Remove Programs.
AppId={{E4B0785D-ABD0-4965-B617-C058A320AB4B}
AppName={#AppName}
AppVersion={#AppVersion}
AppVerName={#AppName} {#AppVersion}
AppPublisher=NightShift AI GmbH
AppPublisherURL=https://nightshift-ai.de
VersionInfoVersion={#AppVersionInfo}
DefaultDirName={autopf}\{#AppName}
DefaultGroupName={#AppName}
DisableProgramGroupPage=yes
PrivilegesRequired=lowest
; Windows 11, the one supported system (README, pyproject classifiers): refuse earlier ones up front instead of
; installing an app that cannot start.
MinVersion=10.0.22000
ArchitecturesAllowed=x64compatible
ArchitecturesInstallIn64BitMode=x64compatible
LicenseFile=..\LICENSE
; Generated by build_installer.py (third_party_notices.py): the licence texts of everything the frozen app contains.
InfoBeforeFile=..\dist\installer\THIRD_PARTY_NOTICES.txt
UninstallDisplayIcon={app}\{#AppExe}
OutputDir=..\dist\installer
OutputBaseFilename=NexusVox-Setup
Compression=lzma2/max
SolidCompression=yes
WizardStyle=modern
; A running NexusVox (usually in the tray) holds its files open and cannot be closed from outside: it has no window
; to send WM_CLOSE to. It owns this mutex (single_instance.py), so Setup and the uninstaller both stop and ask the
; user to quit it from the tray first. A silent install or uninstall fails instead of replacing files under a running
; app.
AppMutex=Local\NexusVox-single-instance
CloseApplications=no
RestartApplications=no

[Languages]
Name: "english"; MessagesFile: "compiler:Default.isl"

[Tasks]
Name: "autostart"; Description: "Start NexusVox when I sign in"; Flags: unchecked

[Files]
Source: "..\dist\NexusVox\*"; DestDir: "{app}"; Flags: ignoreversion recursesubdirs createallsubdirs
Source: "..\LICENSE"; DestDir: "{app}"; Flags: ignoreversion
Source: "..\dist\installer\THIRD_PARTY_NOTICES.txt"; DestDir: "{app}"; Flags: ignoreversion
Source: "..\THIRD_PARTY_LICENSES.md"; DestDir: "{app}"; Flags: ignoreversion

[UninstallDelete]
; Files Setup did not install. The add-ons in extensions run inside the app (microphone, keyboard hook), so they go
; with it; a reinstall must not silently load an old one.
Type: filesandordirs; Name: "{app}\extensions"
Type: filesandordirs; Name: "{app}\_internal"

[Icons]
Name: "{autoprograms}\{#AppName}"; Filename: "{app}\{#AppExe}"

[Registry]
; The same per-user Run key a Settings toggle will use later. No scheduled task, no admin rights.
Root: HKCU; Subkey: "Software\Microsoft\Windows\CurrentVersion\Run"; ValueType: string; ValueName: "{#AppName}"; ValueData: """{app}\{#AppExe}"""; Flags: uninsdeletevalue; Tasks: autostart
; Unticking the task on an upgrade or reinstall must switch autostart off again.
Root: HKCU; Subkey: "Software\Microsoft\Windows\CurrentVersion\Run"; ValueType: none; ValueName: "{#AppName}"; Flags: deletevalue; Tasks: not autostart

[Run]
Filename: "{app}\{#AppExe}"; Description: "Start {#AppName}"; Flags: nowait postinstall skipifsilent

[Code]
{ An upgrade copies the new build over the old one. Files only the old build had (renamed DLLs, old .dist-info
  folders that importlib.metadata would still find, removed packages) must not stay behind, but deleting the old
  _internal before the copy would leave an app that cannot start if the upgrade is cancelled or fails half way. So
  the old folder is moved aside first, deleted once the new files are in, and moved back if Setup does not get that
  far. The extensions folder next to it is never touched. }

var
  InternalMovedAside: Boolean;
  InstallFinished: Boolean;

function InternalDir: String;
begin
  Result := ExpandConstant('{app}\_internal');
end;

procedure CurStepChanged(CurStep: TSetupStep);
begin
  if CurStep = ssInstall then
  begin
    { Left over from an upgrade that was killed half way. }
    if DirExists(InternalDir + '.old') then
      DelTree(InternalDir + '.old', True, True, True);
    if DirExists(InternalDir) then
      InternalMovedAside := RenameFile(InternalDir, InternalDir + '.old');
  end
  else if CurStep = ssPostInstall then
  begin
    InstallFinished := True;
    if InternalMovedAside then
      DelTree(InternalDir + '.old', True, True, True);
  end;
end;

procedure DeinitializeSetup;
begin
  { Cancelled or failed: Setup has rolled back the files it added; put the old runtime back. }
  if InternalMovedAside and not InstallFinished then
  begin
    if DirExists(InternalDir) then
      DelTree(InternalDir, True, True, True);
    RenameFile(InternalDir + '.old', InternalDir);
  end;
end;

{ The uninstaller removes the program and its add-ons. The user's own files live outside the install folder:
    config:  %APPDATA%\NexusVox
    data:    %LOCALAPPDATA%\NexusVox\data (history database, stored audio)
    logs:    %LOCALAPPDATA%\NexusVox\logs
    models:  %LOCALAPPDATA%\NexusVox\models (downloaded speech models, several hundred MB) and
             %LOCALAPPDATA%\NexusVox\models-xet (the Hugging Face chunk cache, which holds model data too)
  The default locations only: a database or audio folder moved elsewhere in Settings is not touched, and the question
  says so. Two questions, both defaulting to keep. A silent uninstall keeps everything unless it is told otherwise
  with /DELETEDATA and /DELETEMODELS. }

function HasSwitch(const Name: String): Boolean;
var
  I: Integer;
begin
  Result := False;
  for I := 1 to ParamCount do
    if CompareText(ParamStr(I), Name) = 0 then
      Result := True;
end;

{ DelTree reports a folder that does not exist as a failure. Nothing to delete is not a failure. }
function RemoveFolder(const Path: String): Boolean;
begin
  Result := (not DirExists(Path)) or DelTree(Path, True, True, True);
end;

function WantsDelete(const Switch, Question: String): Boolean;
begin
  if HasSwitch(Switch) then
    Result := True
  else if UninstallSilent then
    Result := False
  else
    Result := MsgBox(Question, mbConfirmation, MB_YESNO or MB_DEFBUTTON2) = IDYES;
end;

procedure CurUninstallStepChanged(CurUninstallStep: TUninstallStep);
var
  LocalRoot: String;
  Failed: Boolean;
begin
  if CurUninstallStep <> usPostUninstall then
    Exit;

  Failed := False;
  LocalRoot := ExpandConstant('{localappdata}\NexusVox');

  if WantsDelete('/DELETEDATA',
      'Also delete your NexusVox data?' + #13#10#13#10 +
      'This removes your settings, dictation history, stored audio and logs from their default folders ' +
      '(%APPDATA%\NexusVox and %LOCALAPPDATA%\NexusVox). Files you moved elsewhere in Settings are not touched. ' +
      'It cannot be undone.' + #13#10#13#10 +
      'Choose No to keep them for a later reinstall.') then
  begin
    Failed := not RemoveFolder(ExpandConstant('{userappdata}\NexusVox'));
    Failed := not RemoveFolder(LocalRoot + '\data') or Failed;
    Failed := not RemoveFolder(LocalRoot + '\logs') or Failed;
  end;

  if WantsDelete('/DELETEMODELS',
      'Also delete the downloaded speech models?' + #13#10#13#10 +
      'They take several hundred MB and are downloaded again when you reinstall and dictate.' + #13#10#13#10 +
      'Choose No to keep them.') then
  begin
    Failed := not RemoveFolder(LocalRoot + '\models') or Failed;
    Failed := not RemoveFolder(LocalRoot + '\models-xet') or Failed;
  end;

  if Failed then
  begin
    Log('Some of the data or model files could not be deleted.');
    if not UninstallSilent then
      MsgBox('Some of your NexusVox files could not be deleted, probably because another program is using them. ' +
        'You can delete the folders by hand:' + #13#10#13#10 + ExpandConstant('{userappdata}\NexusVox') + #13#10 +
        LocalRoot, mbInformation, MB_OK);
  end;

  { Removes the folder only when nothing is left in it. }
  RemoveDir(LocalRoot);
end;
